  cutsceneBGM: {fileID: 8300000, guid: fc224a0cc431edc4c8c2dfa84fa7d544, type: 3}
  id: CS06
  steps:
  - image: {fileID: 21300000, guid: e9844fbee0885434eaa398885bf1307d, type: 3}
    holdTime: 1
    dialogue: "\uB9AC\uBAA8* \uC800\uAE30 \uC0AC\uB77C..\uC788\uC796\uC544 \uC774\uAC70..\r\n\uB9AC\uBAA8\uB294
      \uC0AC\uB77C\uC5D0\uAC8C \uC791\uC740 \uC0AC\uD0D5\uC744 \uAC74\uB0C8\uC2B5\uB2C8\uB2E4.
      \r\n\uC0AC\uB77C* \uC774\uAC70 \uB098\uD55C\uD14C \uC8FC\uB294\uAC70\uC57C?\r\n\uC0AC\uB77C\uAC00
      \uB9D0\uD558\uC790 \uB9AC\uBAA8\uB294 \uC5BC\uAD74\uC774 \uBD89\uC5B4\uC84C\uC2B5\uB2C8\uB2E4.\r\n\uB9AC\uBAA8*\uC788\uC796\uC544..
      \uC0AC\uB77C, \uB098\uB294 \uB124\uAC00 \uB0A0 \uBC1C\uACAC\uD574\uC8FC\uACE0,
      \uB2EC\uB798\uC8FC\uACE0, \uC9C0\uAE08\uAE4C\uC9C0 \uD568\uAED8 \uB2E4\uB140\uC900\uAC8C
      \uB108\uBB34.. \uB108\uBB34.. \uACE0\uB9D9..\r\n\uB9AC\uBAA8\uB294 \uB9D0\uC744
      \uB2E4 \uD558\uC9C0 \uBABB\uD588\uC9C0\uB9CC \uC0AC\uB77C\uB294 \uADF8 \uB73B\uC744
      \uC774\uD574\uD588\uC2B5\uB2C8\uB2E4.\r\n\uC0AC\uB77C* \uACE0\uB9C8\uC6CC \uB9AC\uBAA8,
      \uC798 \uBA39\uC744\uAC8C.\""
    useTypewriter: 1
  - image: {fileID: 21300000, guid: 6cf9bf289180d5a43a78dab05f806828, type: 3}
    holdTime: 1
    dialogue: "\uB9AC\uBAA8*\uC751..!\r\n\uB9AC\uBAA8\uAC00 \uCC98\uC74C\uC73C\uB85C
      \uBC1D\uAC8C \uC6C3\uC73C\uBA70 \uB300\uB2F5\uD588\uC2B5\uB2C8\uB2E4.\r\n\uB9AC\uBAA8*
      \uC0AC\uB77C\uB294 \uC774 \uC138\uACC4\uB97C \uC5EC\uD589\uD558\uB294\uAC8C
      \uAE30\uC5B5\uB54C\uBB38\uC774\uB77C\uACE0 \uD588\uC9C0? \uB098\uCC98\uB7FC
      \uC783\uC5B4\uBC84\uB9B0 \uAE30\uC5B5\uC744 \uCC3E\uC744\uB824\uACE0 \uB9D0\uC774\uC57C.\r\n\uC0AC\uB77C*\uAE30\uC5B5..?
      \uC751 \uADF8\uCE58, \uB098\uB294 \uAE30\uC5B5\uC744 \uCC3E\uAE30 \uC704\uD574
      \uC5EC\uD589\uC744 \uD558\uB294\uAC70\uAE34 \uD558\uC9C0\uB9CC..\r\n\uB9AC\uBAA8*
      \uC774\uC138\uACC4\uC5D0\uB294 \uB9C8\uBC95\uC758 \uD798, \uC2E0\uAE30\uD55C
      \uD798\uB4E4\uC774 \uC788\uC5B4. \uB098\uB294 \uADF8\uAC78 \uAE30\uC6B4\uC73C\uB85C
      \uB098\uB9C8 \uC870\uAE08 \uB290\uB084\uC218\uC788\uACE0. \uAE30\uC5B5\uB4E4\uC774
      \uBAA8\uC5EC\uC788\uB294 \uC601\uC801\uC778 \uD798, \"\"\uAE30\uC5B5\uC758
      \uD30C\uD3B8\"\"\uC744 \uCC3E\uC73C\uBA74\r\n\uBD84\uBA85 \uC0AC\uB77C\uB3C4
      \uB098\uB3C4 \uAE30\uC5B5\uC744 \uB418\uCC3E\uC744\uC218\uC788\uC744\uAC70\uC57C!\r\n\uC0AC\uB77C*\uC815\uB9D0?
      \uADF8\uAC74 \uC2E0\uAE30\uD55C\uAC78?\r\n\uB9AC\uBAA8* \uC0AC\uB77C! \uC774\uC55E\uC740
      \uC870\uAE08 \uC704\uD5D8\uD560\uC9C0 \uBAB0\uB77C\uB3C4 \uAC19\uC774 \uD798\uB0B4\uBCF4\uC790
      !\r\n\uC0AC\uB77C*\uC88B\uC544! \uB098\uB3C4 \uB9AC\uBAA8\uB3C4 \uD568\uAED8
      \uCC3E\uC544\uAC00\uBCF4\uC790 \""
    useTypewriter: 1
